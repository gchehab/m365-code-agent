{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"]
  },
  "files": [
    "src/i18n.js",
    "src/locales/en.js",
    "src/locales/ko.js",
    "src/locales/pt-BR.js",
    "src/workspace.js",
    "src/tool-call.js",
    "src/changes.js",
    "src/agent.js",
    "src/editor-actions.js",
    "src/mcp.js",
    "test/contracts.typecheck.ts"
  ]
}
